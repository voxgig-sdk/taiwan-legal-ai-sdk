# Entity: case_analysi

main: kit: entity: case_analysi: {

  alias: field: {}

  fields: [
    {
      name: "analysisId"
      req: false
      short: "Unique identifier for the analysis"
      type: "`$STRING`"
    }
    {
      name: "applicableLaws"
      req: false
      short: "Laws applicable to this case"
      type: "`$ARRAY`"
    }
    {
      name: "caseDetails"
      req: true
      short: "Detailed description of the case"
      type: "`$STRING`"
    }
    {
      name: "caseType"
      req: false
      short: "Type of legal case"
      type: "`$STRING`"
    }
    {
      name: "language"
      req: false
      type: "`$STRING`"
    }
    {
      name: "legalIssues"
      req: false
      short: "Identified legal issues"
      type: "`$ARRAY`"
    }
    {
      name: "parties"
      req: false
      short: "Information about parties involved"
      type: "`$OBJECT`"
    }
    {
      name: "precedents"
      req: false
      short: "Relevant legal precedents"
      type: "`$ARRAY`"
    }
    {
      name: "recommendations"
      req: false
      short: "AI recommendations for case strategy"
      type: "`$STRING`"
    }
    {
      name: "summary"
      req: false
      short: "Summary of the case analysis"
      type: "`$STRING`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "case_analysi"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/case-analysis"
          parts: [
            "case-analysis"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
