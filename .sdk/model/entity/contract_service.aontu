# Entity: contract_service

main: kit: entity: contract_service: {

  alias: field: {}

  fields: [
    {
      name: "clauses"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "complianceCheck"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "content"
      req: false
      type: "`$STRING`"
    }
    {
      name: "contractText"
      req: true
      type: "`$STRING`"
    }
    {
      name: "contractType"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "draftId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "focusAreas"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "issues"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "language"
      req: false
      type: "`$STRING`"
    }
    {
      name: "missingClauses"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "notes"
      req: false
      type: "`$STRING`"
    }
    {
      name: "overallAssessment"
      req: false
      type: "`$STRING`"
    }
    {
      name: "parties"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "recommendations"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "requirements"
      req: true
      type: "`$STRING`"
    }
    {
      name: "reviewId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "riskLevel"
      req: false
      type: "`$STRING`"
    }
    {
      name: "specificClauses"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "contract_service"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/contract/draft"
          parts: [
            "contract"
            "draft"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/contract/review"
          parts: [
            "contract"
            "review"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
